Options -Indexes -ExecCGI

<IfModule mod_rewrite.c>
  RewriteEngine On

  # A hospedagem é estática: recuse métodos que poderiam tentar gravar ou executar conteúdo.
  RewriteCond %{REQUEST_METHOD} !^(GET|HEAD|OPTIONS)$ [NC]
  RewriteRule ^ - [R=405,L]

  # Redirecione apenas o domínio definitivo; o endereço temporário continua útil para testes.
  RewriteCond %{HTTP_HOST} ^(?:www\.)?marciofelipearquitetura\.com\.br$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\.marciofelipearquitetura\.com\.br$ [NC]
  RewriteRule ^ https://marciofelipearquitetura.com.br%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; form-action 'self'; frame-src https://www.google.com https://www.recaptcha.net https://zoryon-web-portfolio.firebaseapp.com; frame-ancestors 'none'; script-src 'self' 'sha256-qdA5Z9FSh/PrC6mr0a77I8wbXEMZ8o0TUB2pjrkw9tE=' https://cdn.jsdelivr.net https://www.gstatic.com https://www.google.com https://www.recaptcha.net; script-src-attr 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob: https://duduwwl.github.io; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://securetoken.googleapis.com https://identitytoolkit.googleapis.com https://firebaseappcheck.googleapis.com https://www.google.com https://www.recaptcha.net; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "accelerometer=(), autoplay=(self), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), browsing-topics=()"
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set X-Permitted-Cross-Domain-Policies "none"
  Header unset X-Powered-By
</IfModule>

<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType image/webp .webp
</IfModule>

<FilesMatch "(^\.|\.(?:bak|conf|ini|log|map|md|ps1|rules|sql|ya?ml))$">
  Require all denied
</FilesMatch>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>
